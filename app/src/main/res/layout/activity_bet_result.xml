<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:padding="20dp"
    tools:context=".ui.BetResultActivity">

    <!-- Result Icon (Win/Lose) -->
    <ImageView
        android:id="@+id/ivResultIcon"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="40dp"
        android:contentDescription="Result Icon"
        android:src="@drawable/ic_win"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Result Title -->
    <TextView
        android:id="@+id/tvResultTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:text="Congratulations! You Won!"
        android:textColor="@color/win_green"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivResultIcon" />

    <!-- Bet Result Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardBetResult"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp"
        app:cardBackgroundColor="#2A2A2A"
        app:cardCornerRadius="15dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResultTitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Money Before -->
            <TextView
                android:id="@+id/tvMoneyBefore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="Previous: $1000"
                android:textColor="@color/white"
                android:textSize="18sp" />

            <!-- Money Change (+ or -) -->
            <TextView
                android:id="@+id/tvMoneyChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="+500"
                android:textColor="@color/win_green"
                android:textSize="36sp"
                android:textStyle="bold" />

            <!-- Divider -->
            <View
                android:layout_width="150dp"
                android:layout_height="2dp"
                android:layout_marginBottom="10dp"
                android:background="@color/gold" />

            <!-- Money After -->
            <TextView
                android:id="@+id/tvMoneyAfter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current: $1500"
                android:textColor="@color/win_green"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Buttons Container -->
    <LinearLayout
        android:id="@+id/layoutButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="30dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardBetResult"
        app:layout_constraintVertical_bias="0.0">

        <!-- Play Again Button -->
        <Button
            android:id="@+id/btnPlayAgain"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:backgroundTint="@color/win_green"
            android:text="Play Again"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Statistics Button -->
        <Button
            android:id="@+id/btnViewStats"
            android:layout_width="250dp"
            android:layout_height="60dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/gold"
            android:text="View Statistics"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
